# Explicit stable source-distribution boundary
include LICENSE
include README.md
include pyproject.toml
include setup.cfg
include setup.py
recursive-include src/cryptography_suite *.py py.typed
prune cryptography_suite
prune src/crypto_suite
prune src/suite
prune protocol
prune examples
prune fuzz
prune notebooks
prune generated_None
prune keys
exclude example_usage.py
exclude demo_homomorphic.py
prune docs
prune tests
prune tools
